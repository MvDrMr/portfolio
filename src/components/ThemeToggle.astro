---
import SunIcon from "./icons/Sun.astro";
import MoonIcon from "./icons/Moon.astro";
import SystemIcon from "./icons/System.astro";
import { getTranslations, type Language } from "@/config/translations";

const language: Language = Astro.url.pathname.startsWith("/en")
  ? "en"
  : "es";

const t = getTranslations(language);

const THEMES = [
  { value: "light", label: t.theme.light },
  { value: "dark", label: t.theme.dark },
  { value: "system", label: t.theme.system },
];
---

<div class="relative ml-1 mr-1">
  <button
    transition:persist
    id="theme-toggle-btn"
    class="appearance-none border-none flex hover:scale-125 transition"
  >
    <span id="theme-aria-label" class="sr-only">
      {t.theme.ariaLabel}
    </span>

    <SunIcon id="light" class="theme-toggle-icon size-5 transition-all" />

    <MoonIcon
      id="dark"
      class="theme-toggle-icon absolute size-5 transition-all"
    />

    <SystemIcon
      id="system"
      class="theme-toggle-icon absolute size-5 transition-all"
    />
  </button>

  <div
    transition:persist
    id="themes-menu"
    class="absolute hidden scale-80 top-8 right-0 text-sm p-1 min-w-[8rem] rounded-md border border-gray-100 bg-white/90 dark:bg-gray-900/90 dark:border-gray-500/20 shadow-[0_3px_10px_rgb(0,0,0,0.2)] backdrop-blur-md"
  >
    <ul>
      {
        THEMES.map((theme) => (
          <li
            class="themes-menu-option px-2 py-1.5 cursor-default hover:bg-neutral-400/40 dark:hover:bg-gray-500/50 rounded-sm"
            data-theme={theme.value}
          >
            <span class="theme-label">{theme.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  #themes-menu.open {
    display: inline;
    animation: scale-up-center 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94)
      both;
  }

  @keyframes scale-up-center {
    from {
      transform: scale(0.8);
      opacity: 0;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script is:inline>
  const matchMedia = window.matchMedia("(prefers-color-scheme: dark)");

  const getThemePreference = () => {
    if (typeof localStorage !== "undefined") {
      return localStorage.getItem("theme") ?? "system";
    }

    return matchMedia.matches ? "dark" : "light";
  };

  const updateIcon = (themePreference) => {
    document.querySelectorAll(".theme-toggle-icon").forEach((element) => {
      element.style.scale =
        element.id === themePreference ? "1" : "0";
    });
  };

  const updateTheme = () => {
    const themePreference = getThemePreference();

    const isDark =
      themePreference === "dark" ||
      (themePreference === "system" && matchMedia.matches);

    updateIcon(themePreference);

    document.documentElement.classList[isDark ? "add" : "remove"]("dark");
  };

  const updateLanguage = () => {
    const isEnglish = window.location.pathname.startsWith("/en");

    const translations = isEnglish
      ? {
          ariaLabel: "Choose theme",
          light: "Light",
          dark: "Dark",
          system: "System",
        }
      : {
          ariaLabel: "Elige el tema",
          light: "Claro",
          dark: "Oscuro",
          system: "Sistema",
        };

    const ariaLabel = document.getElementById("theme-aria-label");

    if (ariaLabel) {
      ariaLabel.textContent = translations.ariaLabel;
    }

    const lightLabel = document.querySelector(
      '[data-theme="light"] .theme-label'
    );

    const darkLabel = document.querySelector(
      '[data-theme="dark"] .theme-label'
    );

    const systemLabel = document.querySelector(
      '[data-theme="system"] .theme-label'
    );

    if (lightLabel) {
      lightLabel.textContent = translations.light;
    }

    if (darkLabel) {
      darkLabel.textContent = translations.dark;
    }

    if (systemLabel) {
      systemLabel.textContent = translations.system;
    }
  };

  const initializeThemeToggle = () => {
    const themesMenu = document.getElementById("themes-menu");
    const themeToggleButton = document.getElementById("theme-toggle-btn");

    if (!themesMenu || !themeToggleButton) {
      return;
    }

    /*
     * Evitamos inicializar el componente más de una vez.
     */
    if (themeToggleButton.dataset.initialized === "true") {
      return;
    }

    themeToggleButton.dataset.initialized = "true";

    themeToggleButton.addEventListener("click", (event) => {
      event.stopPropagation();

      themesMenu.classList.toggle("open");
    });

    themesMenu.addEventListener("click", (event) => {
      event.stopPropagation();

      const option = event.target.closest(".themes-menu-option");

      if (!option) {
        return;
      }

      const theme = option.dataset.theme;

      if (theme) {
        localStorage.setItem("theme", theme);
        updateTheme();
        themesMenu.classList.remove("open");
      }
    });

    document.addEventListener("click", () => {
      themesMenu.classList.remove("open");
    });

    matchMedia.addEventListener("change", updateTheme);
  };

  updateTheme();
  updateLanguage();
  initializeThemeToggle();

  document.addEventListener("astro:after-swap", () => {
    updateLanguage();
    updateTheme();

    window.scrollTo({
      left: 0,
      top: 0,
      behavior: "instant",
    });
  });
</script>