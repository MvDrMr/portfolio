---
const personalImageAlt = "Marvin Rodas";
import Badge from "@/components/Badge.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import SocialPill from "@/components/SocialPill.astro";
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-16"
      src="/marvinDev.webp"
      alt={personalImageAlt}
    />
    <a
      href="https://www.linkedin.com/in/marvin-gustavo-rodas-monzón-737583254/"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Disponible para trabajar</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hey, soy Marvin Rodas
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-green-200 [&>strong]:text-green-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    Desarrollador Full Stack con 2 años de experiencia en el desarrollo de
    aplicaciones web. He trabajado con <strong
      >C#, ASP.NET, React, Node.js y bases de datos relacionales,
    </strong>desarrollando APIs REST, interfaces web y soluciones basadas en
    <strong>Programación Orientada a Objetos (POO)</strong>
    y arquitecturas de 3 y N capas. Utilizo Git/GitHub para la gestión del código
    y aplico buenas prácticas de desarrollo.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill
      href="mailto:dragonwanted95@gmail.com?subject=Contacto%20desde%20mi%20portfolio"
    >
      <MailIcon class="size-4" />
      Contáctame
    </SocialPill>
    <SocialPill
      href="https://www.linkedin.com/in/marvin-gustavo-rodas-monzón-737583254/"
    >
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
  </nav>
</div>
