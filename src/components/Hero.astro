---
import { getTranslations, type Language } from "@/config/translations";

import Badge from "@/components/Badge.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import SocialPill from "@/components/SocialPill.astro";
import DownloadIcon from "@/components/icons/Download.astro";

const language: Language = Astro.url.pathname.startsWith("/en") ? "en" : "es";
const t = getTranslations(language);

const personalImageAlt = "Marvin Rodas";

const profile =
  Astro.params.profile === "web" ||
  Astro.params.profile === "dotnet" ||
  Astro.params.profile === "fullstack"
    ? Astro.params.profile
    : "fullstack";

const cvUrl = `/cv/${language}/cv-${profile}.pdf`;
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-16"
      src="/marvinDev.webp"
      alt={personalImageAlt}
    />

    <a
      href="https://www.linkedin.com/in/marvin-gustavo-rodas-monzón-737583254/"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>{t.hero.available}</Badge>
    </a>
  </div>

  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    {t.hero.greeting}
  </h1>

  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-green-200 [&>strong]:text-green-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    {t.hero.description}
    {" "}
    <strong>{t.hero.descriptionHighlight}</strong>
    {" "}
    {t.hero.descriptionMiddle}
    {" "}
    <strong>{t.hero.poo}</strong>
    {" "}
    {t.hero.architecture}
  </p>

  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill
      href="mailto:marvingussi96@gmail.com?subject=Contacto%20desde%20mi%20portfolio"
    >
      <MailIcon class="size-4" />
      {t.hero.contact}
    </SocialPill>

    <SocialPill
      href="https://www.linkedin.com/in/marvin-gustavo-rodas-monzón-737583254/"
    >
      <LinkedInIcon class="size-4" />
      {t.hero.linkedin}
    </SocialPill>

    <a
      href={cvUrl}
      download
      class="inline-flex items-center justify-center gap-2 px-4 py-1 text-gray-800 transition bg-gray-100 border border-gray-300 rounded-full dark:bg-gray-800 dark:border-gray-600 dark:text-white focus-visible:ring-green-500/80 text-md hover:bg-gray-900 hover:border-gray-700 hover:text-white dark:hover:bg-gray-100 dark:hover:border-gray-300 dark:hover:text-black group max-w-fit focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:bg-black"
    >
      <DownloadIcon class="size-4" />
      {t.hero.downloadCV}
    </a>
  </nav>

  <div class="mt-6">
    <p class="text-sm font-medium text-gray-700 dark:text-gray-300">
      {t.email.label}
    </p>

    <div class="flex flex-wrap items-center gap-3 mt-2">
      <span
        id="email-address"
        class="text-base text-gray-800 dark:text-gray-200"
      >
        marvingussi96@gmail.com
      </span>

      <button
        id="copy-email-btn"
        type="button"
        class="inline-flex items-center justify-center gap-2 px-3 py-1.5 text-sm font-medium text-gray-800 transition bg-gray-100 border border-gray-300 rounded-lg dark:bg-gray-800 dark:border-gray-600 dark:text-white hover:bg-gray-900 hover:border-gray-700 hover:text-white dark:hover:bg-gray-100 dark:hover:border-gray-300 dark:hover:text-black focus:outline-none focus-visible:ring focus-visible:ring-green-500/80"
        data-copy-text={t.email.copy}
        data-copied-text={t.email.copied}
      >
        {t.email.copy}
      </button>
    </div>
  </div>
</div>

<script is:inline>
  const initializeCopyEmail = () => {
    const copyButton = document.getElementById("copy-email-btn");
    const emailAddress = document.getElementById("email-address");

    if (!copyButton || !emailAddress) {
      return;
    }

    if (copyButton.dataset.initialized === "true") {
      return;
    }

    copyButton.dataset.initialized = "true";

    copyButton.addEventListener("click", async () => {
      const email = emailAddress.textContent?.trim();

      if (!email) {
        return;
      }

      try {
        await navigator.clipboard.writeText(email);

        copyButton.textContent = copyButton.dataset.copiedText || "Copied!";

        setTimeout(() => {
          copyButton.textContent = copyButton.dataset.copyText || "Copy";
        }, 2000);
      } catch (error) {
        console.error("No se pudo copiar el correo:", error);
      }
    });
  };

  initializeCopyEmail();

  document.addEventListener("astro:after-swap", () => {
    initializeCopyEmail();
  });
</script>
