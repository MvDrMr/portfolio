---
import { getTranslations, type Language } from "@/config/translations";

const language: Language = Astro.url.pathname.startsWith("/en")
  ? "en"
  : "es";

const t = getTranslations(language);

const personalImageAlt = "Marvin Rodas";
---

<article
  class="flex flex-col items-center justify-center gap-8 text-gray-700 dark:text-gray-300 md:flex-row"
>
  <div
    class="[&>p]:mb-4 [&>p>strong]:text-green-500 dark:[&>p>strong]:text-green-100 [&>p>strong]:font-normal [&>p>strong]:font-mono text-pretty order-2 md:order-1"
  >
    <p>{t.about.description}</p>
  </div>

  <img
    width="200"
    height="200"
    src="/marvinDev.webp"
    alt={personalImageAlt}
    class="order-1 object-cover w-64 h-full p-1 md:order-2 rotate-3 lg:p-2 lg:w-64 aspect-square rounded-2xl bg-black/20 dark:bg-green-500/5 ring-1 ring-black/70 dark:ring-white/20"
    style="object-position: 50% 50%"
  />
</article>