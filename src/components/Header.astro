---
import ThemeToggle from "./ThemeToggle.astro";
import { getTranslations, type Language } from "@/config/translations";

const pathname = Astro.url.pathname;

const language: Language = pathname.startsWith("/en") ? "en" : "es";
const t = getTranslations(language);

const basePath = language === "en" ? "/en" : "";

const navItems = [
  {
    title: t.navigation.experience,
    label: "experiencia",
    url: `${basePath}/#experiencia`,
  },
  {
    title: t.navigation.projects,
    label: "proyectos",
    url: `${basePath}/#proyectos`,
  },
  {
    title: t.navigation.about,
    label: "sobre-mi",
    url: `${basePath}/#sobre-mi`,
  },
  {
    title: t.navigation.contact,
    label: "contacto",
    url: "mailto:marvingussi96@gmail.com?subject=Contacto%20desde%20mi%20portfolio",
  },
];

const languageUrl =
  language === "es"
    ? `/en${pathname === "/" ? "" : pathname}`
    : pathname.replace(/^\/en/, "") || "/";

const languageLabel = language === "es" ? "EN" : "ES";
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    class="flex items-center justify-center px-3 text-sm font-medium text-gray-600 rounded-full dark:text-gray-200"
  >
    {
      navItems.map((link) => (
        <a
          class="relative block px-2 py-2 transition hover:text-green-400 dark:hover:text-green-400"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }

    <a
      href={languageUrl}
      class="relative block px-2 py-2 transition hover:text-green-400 dark:hover:text-green-400"
      aria-label={`Cambiar idioma a ${languageLabel}`}
    >
      {languageLabel}
    </a>
    
    <ThemeToggle />
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a");

    const callback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") === entry.target.id) {
              item.classList.add("text-green-400");
            } else {
              item.classList.remove("text-green-400");
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    });

    sections.forEach((section) => {
      observer.observe(section);
    });

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  nav {
    @apply dark:bg-gray-800/90 bg-white/50;
  }

  @keyframes nav-shadown {
    0% {
      @apply dark:bg-gray-800/0 bg-white/0;
    }
    to {
      @apply shadow-lg ring-1 backdrop-blur ring-white/10;
    }
  }
</style>
