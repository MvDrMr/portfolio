---
import GitHub from "./icons/GitHub.astro";
import LinkedIn from "./icons/LinkedIn.astro";
import { getTranslations, type Language } from "@/config/translations";

const currentYear = new Date().getFullYear();

const language: Language = Astro.url.pathname.startsWith("/en") ? "en" : "es";

const t = getTranslations(language);

const footerLinks = [
  {
    title: t.footer.about,
    url: `${language === "en" ? "/en" : ""}/#sobre-mi`,
  },
  {
    title: t.footer.experience,
    url: `${language === "en" ? "/en" : ""}/#experiencia`,
  },
  {
    title: t.footer.projects,
    url: `${language === "en" ? "/en" : ""}/#proyectos`,
  },
  {
    title: t.footer.contact,
    url: `mailto:marvingussi96@gmail.com?subject=Contacto%20desde%20mi%20portfolio`,
  },
];
---

<footer class="w-full xl:w-[1120px] mx-auto mb-3 px-4">
  <hr class="my-6 border-gray-300 dark:border-gray-700 sm:my-8" />

  <div
    class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="text-sm text-gray-500 dark:text-gray-400">
      © {currentYear}
      <span class="text-green-400">Marvin Gustavo Rodas Monzón</span>
    </div>

    <nav
      aria-label={t.footer.navigation}
      class="flex flex-wrap items-center gap-x-5 gap-y-2"
    >
      {
        footerLinks.map((link) => (
          <a
            href={link.url}
            class="text-sm text-gray-500 transition hover:text-green-400 dark:text-gray-400"
          >
            {link.title}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4">
      <a
        href="https://github.com/MvDrMr"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="text-gray-500 transition hover:text-green-400 dark:text-gray-400"
      >
        <GitHub class="size-5" />
        <span class="sr-only">GitHub</span>
      </a>

      <a
        href="https://www.linkedin.com/in/marvin-gustavo-rodas-monzón-737583254/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="text-gray-500 transition hover:text-green-400 dark:text-gray-400"
      >
        <LinkedIn class="size-5" />
        <span class="sr-only">LinkedIn</span>
      </a>
    </div>
  </div>
</footer>