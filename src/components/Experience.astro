---
import ExperienceItem from "./ExperienceItem.astro";
import { getTranslations, type Language } from "@/config/translations";

const language: Language = Astro.url.pathname.startsWith("/en") ? "en" : "es";

const t = getTranslations(language);

const EXPERIENCE = [
  {
    ...t.experience.items.spirit,
    company: "Spirit Computación S.A",
    link: "",
  },
  {
    ...t.experience.items.nebaro,
    company: "Café NEBARO",
  },
  {
    ...t.experience.items.energym,
    company: "Energym",
  },
  {
    ...t.experience.items.mundoConectado,
    company: "Proyecto de Ingeniería en Sistemas",
  },
];
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li>
        <ExperienceItem {...experience} language={language} />
      </li>
    ))
  }
</ol>